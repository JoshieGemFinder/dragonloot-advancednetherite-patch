{
	"schemaVersion": 1,
	"id": "dragon_loot_advanced_netherite_patch",
	"version": "${version}",
	"name": "Dragon Loot Advanced Netherite Patch",
	"description": "Compatibility mod that patches DragonLoot to be after Advanced Netherite in progression",
	"authors": [
		"JoshieGemFinder"
	],
	"contact": {
		"__homepage1": "https://www.curseforge.com/minecraft/mc-mods/dragonloot-advanced-netherite-progression",
		"__homepage2": "https://modrinth.com/project/dragonloot-advanced-netherite-progression",
		"issues": "https://github.com/JoshieGemFinder/dragonloot-advancednetherite-patch/issues",
		"sources": "https://github.com/JoshieGemFinder/dragonloot-advancednetherite-patch/tree/${minecraft_version}-fabric"
	},
	"license": "LGPL-3.0-or-later",
	"icon": "assets/dragon_loot_advanced_netherite_patch/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.joshiegemfinder.dragonlootadvancednetheritepatch.DragonLootAdvancedNetheritePatch"
		],
		"client": [
			"com.joshiegemfinder.dragonlootadvancednetheritepatch.DragonLootAdvancedNetheritePatchClient"
		]
	},
	"mixins": [
		"dragon_loot_advanced_netherite_patch.mixins.json",
		"dragon_loot_advanced_netherite_patch.compat.mixins.json"
	],
	"depends": {
		"java": ">=17",
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"fabric-api": "${fabric_api_version_range}",
		"advancednetherite": "${advancednetherite_version_range}",
		"dragonloot": "${dragonloot_version_range}"
	},
	"suggests": {
		"advanced_netherite_medieval_weapons": "${advanced_netherite_medieval_weapons_version_range}"
	}
}